# syntax=docker/dockerfile:1

# CUTOVER-1A backend-only release artifact.
# This image intentionally never copies the frozen legacy frontend from src/.
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY server/ server/
RUN npx tsc --project server/tsconfig.json

FROM node:22-alpine AS production

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=5000

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=builder /app/dist/server ./dist/server

RUN addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup

USER appuser

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:5000/health || exit 1

# The tsx loader preserves the current extensionless ESM import contract in the
# compiled server output while the source tree is incrementally modernized.
CMD ["node", "--import", "tsx", "dist/server/index.js"]
