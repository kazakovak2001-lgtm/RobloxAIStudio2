# syntax=docker/dockerfile:1

# CUTOVER-1A backend-only release artifact.
# This image intentionally never copies the frozen legacy frontend from src/.
FROM node:22-alpine AS builder

WORKDIR /app

ENV HUSKY=0

COPY package.json package-lock.json ./
RUN npm ci

COPY server/ server/
COPY scripts/build-server-bundle.mjs scripts/build-server-bundle.mjs
RUN npx tsc --noEmit --project server/tsconfig.json
RUN node scripts/build-server-bundle.mjs
RUN npm prune --omit=dev && npm cache clean --force

FROM node:22-alpine AS production

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=5000

COPY package.json package-lock.json ./
COPY architecture.manifest.json ./architecture.manifest.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist/server-bundle ./dist/server-bundle

# npm and npx are build-time tooling only. Removing the global npm distribution
# from the runtime stage reduces the shipped attack surface while preserving the
# Node.js executable required by the application.
RUN rm -rf /usr/local/lib/node_modules/npm \
    /usr/local/bin/npm \
    /usr/local/bin/npx && \
    addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup

USER appuser

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:5000/health || exit 1

# BUILD-1. esbuild resolves the source tree's extensionless ESM imports at build
# time, so the runtime is plain Node.js with no tsx loader.
CMD ["node", "--enable-source-maps", "dist/server-bundle/index.js"]
