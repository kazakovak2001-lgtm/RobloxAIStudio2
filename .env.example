# Frontend environment (Vite)
VITE_SOCKET_URL=http://localhost:5000

# Backend environment
PORT=5000
NODE_ENV=development

# Project-scoped Roblox Studio authentication. Configure both values together.
# Use rai_<16 hex lookup characters>_<32+ random characters> and the exact
# Workspace project ID. The backend stores only the lookup ID and scrypt digest.
# STUDIO_API_KEY=rai_0123456789abcdef_replace-with-32-plus-random-characters
# STUDIO_PROJECT_ID=proj-example

# AI Providers (optional — stub mode without keys)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# OLLAMA_LOCAL=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5-coder:3b

# Persistent Storage (F-11)
# Set to "postgres" to enable PostgreSQL persistence
# STORAGE_PROVIDER=postgres
# DATABASE_URL=postgresql://studio:studio_dev@localhost:5432/roblox_ai_studio

# ─── Production Configuration ────────────────────────────────────────────────
# NODE_ENV=production
# FRONTEND_URL=https://your-domain.com

# Database (required when STORAGE_PROVIDER=postgres)
# STORAGE_PROVIDER=postgres
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Authentication uses random, storage-backed opaque sessions. No JWT/session
# signing secret is required. Production cookies are Secure, HttpOnly,
# SameSite=Lax, host-only, and scoped by the backend.

# AI Providers (at least one required for non-stub mode)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
