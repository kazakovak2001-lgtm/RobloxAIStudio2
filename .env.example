# Frontend environment (Vite)
VITE_SOCKET_URL=http://localhost:5000

# Backend environment
PORT=5000
NODE_ENV=development

# AI Providers (optional — stub mode without keys)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# OLLAMA_LOCAL=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5-coder:3b

# Persistent Storage (F-11)
# Set to "postgres" to enable PostgreSQL persistence
# STORAGE_PROVIDER=postgres
# DATABASE_URL=postgresql://studio:studio_dev@localhost:5432/roblox_ai_studio

# ─── Production Configuration ────────────────────────────────────────────────
# NODE_ENV=production
# FRONTEND_URL=https://your-domain.com

# Database (required when STORAGE_PROVIDER=postgres)
# STORAGE_PROVIDER=postgres
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Security
# JWT_SECRET=your-secure-random-string
# COOKIE_DOMAIN=your-domain.com

# AI Providers (at least one required for non-stub mode)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
