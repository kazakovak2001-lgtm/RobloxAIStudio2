{
  "name": "robloxaistudio-devkit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "securityPolicy": {
    "dependencyAuditLevel": "high",
    "productionOnly": true,
    "sastScanner": "github-codeql/javascript-typescript",
    "sastSeverity": "high",
    "sastConfidence": "high",
    "secretScanner": "gitleaks",
    "secretPullRequestScope": "changed-content",
    "secretHistoryBoundary": "8dd23f88a0b23e2eedf5f2c38a36f0c12570cbab",
    "secretExceptionMaterial": "fingerprint-or-rule-path-only",
    "secretPlaintextMaterialAllowed": false,
    "exceptions": []
  },
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "node --watch --import tsx server/src/index.ts",
    "studio:package": "node --import tsx scripts/package-studio-plugin.ts",
    "validate:arch": "node --import tsx scripts/validate-architecture.ts",
    "validate:boundaries": "node --import tsx scripts/validate-boundaries.ts",
    "validate:layer-debt": "node --import tsx scripts/validate-layer-debt-evidence.ts",
    "validate:runtime": "node --import tsx scripts/validate-runtime-ownership.ts",
    "validate:memory": "node --import tsx scripts/validate-memory-ownership.ts",
    "validate:durable-writes": "node --import tsx scripts/validate-durable-writes.ts",
    "validate:operational-state": "node --import tsx scripts/validate-operational-state-ownership.ts",
    "validate:security-policy": "node --import tsx scripts/validate.ts --security-policy-only",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "scan:imports": "node --import tsx scripts/scan-imports.ts",
    "build": "npm run build:server",
    "build:server": "node --import tsx scripts/validate-architecture.ts && node --import tsx scripts/validate-boundaries.ts && node --import tsx scripts/validate-layer-debt-evidence.ts && node --import tsx scripts/validate-runtime-ownership.ts && node --import tsx scripts/validate-memory-ownership.ts && node --import tsx scripts/validate-durable-writes.ts && node --import tsx scripts/validate-operational-state-ownership.ts && node node_modules/typescript/bin/tsc --project server/tsconfig.json",
    "preview": "npm run start",
    "start": "node --import tsx dist/server/index.js",
    "lint": "node node_modules/eslint/bin/eslint.js server/src scripts config/testing --ext .ts --max-warnings 0",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit --project server/tsconfig.json",
    "test": "node node_modules/vitest/vitest.mjs --config config/testing/vitest.backend.config.ts run",
    "test:watch": "node node_modules/vitest/vitest.mjs --config config/testing/vitest.backend.config.ts",
    "test:postgres": "node node_modules/vitest/vitest.mjs --config config/testing/vitest.backend.config.ts run server/src/__tests__/core1b.postgres.integration.test.ts",
    "validate": "npm run validate:layer-debt && npm run validate:runtime && npm run validate:memory && npm run validate:durable-writes && npm run validate:operational-state && node --import tsx scripts/validate.ts",
    "ci": "npm run typecheck && npm run validate:arch && npm run validate:boundaries && npm run lint && npm run format:check && npm run test && npm run validate",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.20.0",
    "@types/socket.io-client": "^1.4.36",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.6.0",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9"
  }
}
