{
  "name": "robloxaistudio-devkit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "dev:server": "node --watch --import tsx server/src/index.ts",
    "validate:arch": "node --import tsx scripts/validate-architecture.ts",
    "validate:boundaries": "node --import tsx scripts/validate-boundaries.ts",
    "scan:imports": "node --import tsx scripts/scan-imports.ts",
    "build": "node --import tsx scripts/validate-architecture.ts && node --import tsx scripts/validate-boundaries.ts && node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "build:server": "node --import tsx scripts/validate-architecture.ts && node --import tsx scripts/validate-boundaries.ts && node node_modules/typescript/bin/tsc --project server/tsconfig.json",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "start": "node --import tsx dist/server/index.js",
    "lint": "node node_modules/eslint/bin/eslint.js . --ext .ts,.tsx --max-warnings 0",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/typescript/bin/tsc --noEmit --project server/tsconfig.json",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "validate": "node --import tsx scripts/validate.ts",
    "ci": "npm run typecheck && npm run validate:arch && npm run validate:boundaries && npm run lint && npm run format:check && npm run test && npm run validate",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "framer-motion": "^12.42.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.21.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/socket.io-client": "^1.4.36",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.6.0",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "postcss": "^8.4.49",
    "prettier": "^3.9.4",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^4.1.9"
  }
}
