{
  "schemaVersion": 1,
  "classifications": [
    "canonical",
    "bounded-adapter",
    "preview",
    "deprecated",
    "removed"
  ],
  "productionUsePolicies": [
    "allowed",
    "adapter-only",
    "preview-route",
    "preview-internal",
    "forbidden"
  ],
  "memoryPolicy": {
    "durableProductStateOwner": null,
    "statement": "No registered memory runtime owns durable product state. Current memory systems are execution-scoped or process-local and all are restart-volatile."
  },
  "canonicalByCapability": {
    "execution-engine": "planning-plan-executor",
    "provider-construction": "providers-llm-provider-factory"
  },
  "inventoryRules": [
    {
      "root": "server/src/planning/execution",
      "pattern": "(?:Executor|Controller|Orchestrator|Integrator|Factory|Registry|Engine|Manager|Bridge)\\.ts$"
    },
    {
      "root": "server/src/runtime/controller",
      "pattern": "(?:Executor|Controller|Orchestrator|Integrator|Factory|Registry|Engine|Manager|Bridge)\\.ts$"
    },
    {
      "root": "server/src/orchestrator",
      "pattern": "(?:Executor|Controller|Orchestrator|Integrator|Factory|Registry|Engine|Manager|Bridge)\\.ts$"
    },
    {
      "root": "server/src/pipeline/v2",
      "pattern": "(?:PipelineEngine|PipelineExecutor)\\.ts$"
    },
    {
      "root": "server/src/execution",
      "pattern": "aiPipelineIntegrator\\.ts$"
    },
    {
      "root": "server/src/integration",
      "pattern": "(?:PlatformIntegrationManager|EndToEndValidator)\\.ts$"
    },
    {
      "root": "server/src/providers",
      "pattern": "providerFactory\\.ts$"
    },
    {
      "root": "server/src/providers/ai",
      "pattern": "Provider(?:Factory|Registry)\\.ts$"
    },
    {
      "root": "server/src/memory",
      "pattern": "MemoryRegistry\\.ts$"
    },
    {
      "root": "server/src/memory/agents",
      "pattern": "AgentMemoryBridge\\.ts$"
    },
    {
      "root": "server/src/memory/core",
      "pattern": "MemoryEngine\\.ts$"
    },
    {
      "root": "server/src/memory/knowledge",
      "pattern": "MemoryManager\\.ts$"
    }
  ],
  "entries": [
    {
      "id": "planning-plan-executor",
      "capability": "execution-engine",
      "path": "server/src/planning/execution/PlanExecutor.ts",
      "classification": "canonical",
      "owner": "planning",
      "productionUse": "allowed",
      "responsibility": "Canonical DAG-based production execution engine."
    },
    {
      "id": "runtime-execution-controller",
      "capability": "execution-lifecycle",
      "path": "server/src/runtime/controller/RuntimeExecutionController.ts",
      "classification": "bounded-adapter",
      "owner": "runtime",
      "productionUse": "adapter-only",
      "responsibility": "Lifecycle, checkpoint, telemetry and error-boundary adapter around PlanExecutor."
    },
    {
      "id": "pipeline-v2-engine",
      "capability": "execution-engine",
      "path": "server/src/pipeline/v2/PipelineEngine.ts",
      "classification": "preview",
      "owner": "pipeline",
      "productionUse": "preview-route",
      "responsibility": "Preview stage pipeline with in-memory persistence and artifact review facilities.",
      "replacement": "planning-plan-executor",
      "allowedImporters": [
        "server/src/pipeline/v2/index.ts",
        "server/src/routes/concept.ts"
      ]
    },
    {
      "id": "pipeline-v2-executor",
      "capability": "execution-engine",
      "path": "server/src/pipeline/v2/PipelineExecutor.ts",
      "classification": "preview",
      "owner": "pipeline",
      "productionUse": "preview-internal",
      "responsibility": "Internal executor owned by the preview Pipeline v2 facade.",
      "replacement": "planning-plan-executor",
      "allowedImporters": [
        "server/src/pipeline/v2/PipelineEngine.ts",
        "server/src/pipeline/v2/index.ts"
      ]
    },
    {
      "id": "autonomous-orchestrator",
      "capability": "autonomous-orchestration",
      "path": "server/src/orchestrator/AutonomousOrchestrator.ts",
      "classification": "preview",
      "owner": "orchestrator",
      "productionUse": "preview-route",
      "responsibility": "Preview autonomous lifecycle whose named phases currently use simulated execution.",
      "replacement": "runtime-execution-controller",
      "allowedImporters": [
        "server/src/orchestrator/index.ts",
        "server/src/routes/autonomous.ts"
      ]
    },
    {
      "id": "execution-ai-pipeline-integrator",
      "capability": "execution-engine",
      "path": "server/src/execution/aiPipelineIntegrator.ts",
      "classification": "deprecated",
      "owner": "execution",
      "productionUse": "forbidden",
      "responsibility": "Legacy planning and memory integrator retained only for constants and compatibility types.",
      "replacement": "planning-plan-executor",
      "allowedImporters": []
    },
    {
      "id": "platform-integration-manager",
      "capability": "platform-orchestration",
      "path": "server/src/integration/PlatformIntegrationManager.ts",
      "classification": "preview",
      "owner": "integration",
      "productionUse": "preview-internal",
      "responsibility": "Internal preview composition root for legacy subsystem demonstrations; not a production bootstrap path.",
      "replacement": "runtime-execution-controller",
      "allowedImporters": ["server/src/integration/EndToEndValidator.ts"]
    },
    {
      "id": "platform-end-to-end-validator",
      "capability": "platform-validation",
      "path": "server/src/integration/EndToEndValidator.ts",
      "classification": "preview",
      "owner": "integration",
      "productionUse": "preview-internal",
      "responsibility": "Internal validator for the legacy preview platform composition stack; not the protected production contract suite.",
      "replacement": "runtime-execution-controller",
      "allowedImporters": []
    },
    {
      "id": "providers-llm-provider-factory",
      "capability": "provider-construction",
      "path": "server/src/providers/providerFactory.ts",
      "classification": "canonical",
      "owner": "providers",
      "productionUse": "allowed",
      "responsibility": "Canonical environment-driven LLM provider construction path."
    },
    {
      "id": "providers-ai-provider-factory",
      "capability": "provider-construction",
      "path": "server/src/providers/ai/ProviderFactory.ts",
      "classification": "preview",
      "owner": "providers",
      "productionUse": "preview-internal",
      "responsibility": "Internal secondary factory retained only for the advanced provider preview stack and direct tests.",
      "replacement": "providers-llm-provider-factory",
      "allowedImporters": [
        "server/src/integration/PlatformIntegrationManager.ts"
      ]
    },
    {
      "id": "providers-ai-provider-registry",
      "capability": "provider-registry",
      "path": "server/src/providers/ai/ProviderRegistry.ts",
      "classification": "preview",
      "owner": "providers",
      "productionUse": "preview-internal",
      "responsibility": "Internal in-process registry for the advanced provider preview stack.",
      "allowedImporters": [
        "server/src/integration/PlatformIntegrationManager.ts",
        "server/src/providers/ai/ProviderFactory.ts",
        "server/src/providers/ai/ProviderHealthService.ts",
        "server/src/providers/ai/RetryPolicy.ts"
      ]
    },
    {
      "id": "memory-execution-registry",
      "capability": "execution-memory",
      "path": "server/src/memory/MemoryRegistry.ts",
      "classification": "bounded-adapter",
      "owner": "memory",
      "productionUse": "adapter-only",
      "responsibility": "Execution-scoped ProjectMemory registry with explicit post-run eviction behavior.",
      "lifecycle": "execution",
      "durability": "restart-volatile",
      "bounds": "The default maxHistory is 10 retained inspection entries after explicit evictions; active executions have no hard cap, and each evict call removes at most one oldest non-current entry."
    },
    {
      "id": "memory-agent-bridge",
      "capability": "agent-memory",
      "path": "server/src/memory/agents/AgentMemoryBridge.ts",
      "classification": "bounded-adapter",
      "owner": "memory",
      "productionUse": "adapter-only",
      "responsibility": "Non-blocking adapter between agent execution and the process-local memory engine.",
      "lifecycle": "execution",
      "durability": "restart-volatile",
      "bounds": "Owns no collection; default retrieval delegates to MemoryEngine with a limit of 5 recent entries and 5 semantic matches."
    },
    {
      "id": "memory-engine",
      "capability": "long-term-memory",
      "path": "server/src/memory/core/MemoryEngine.ts",
      "classification": "bounded-adapter",
      "owner": "memory",
      "productionUse": "adapter-only",
      "responsibility": "Active process-local semantic memory adapter used by execution and feedback bridges; restart-volatile and not durable product-state storage.",
      "lifecycle": "process",
      "durability": "restart-volatile",
      "bounds": "The default MemoryStore retains at most 1,000 entries and the default SemanticRetriever indexes at most 500 documents per MemoryEngine instance."
    },
    {
      "id": "knowledge-memory-manager",
      "capability": "project-knowledge-memory",
      "path": "server/src/memory/knowledge/MemoryManager.ts",
      "classification": "preview",
      "owner": "memory",
      "productionUse": "preview-internal",
      "responsibility": "Process-local project knowledge store with bounded entry eviction.",
      "lifecycle": "process",
      "durability": "restart-volatile",
      "bounds": "Retains at most 5,000 entries per manager instance and evicts the least recently updated entries when the limit is exceeded.",
      "allowedImporters": [
        "server/src/integration/PlatformIntegrationManager.ts",
        "server/src/memory/knowledge/ContextResolver.ts",
        "server/src/memory/knowledge/MemoryMetrics.ts",
        "server/src/memory/knowledge/index.ts"
      ]
    }
  ]
}
