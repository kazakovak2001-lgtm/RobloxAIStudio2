        }
      ]
    },
    {
      "path": "server/src/lifecycle/monitor/GameHealthMonitor.ts",
      "owner": "lifecycle",
      "productionStatus": "scaffold",
      "states": [
        {
          "name": "history",
          "classification": "intentionally-ephemeral",
          "source": "bounded runtime telemetry"
        }
      ]
    },
    {
      "path": "server/src/core/observability/TraceStore.ts",
      "owner": "observability",
      "productionStatus": "production-wired",
      "states": [
        {
          "name": "traces/insertionOrder",
          "classification": "intentionally-ephemeral",
