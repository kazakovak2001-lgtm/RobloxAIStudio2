      ]
    },
    {
      "path": "server/src/socket/index.ts",
      "owner": "realtime",
      "productionStatus": "production-wired",
      "states": [
        {
          "name": "players/projectRooms",
          "classification": "restart-reconstructible",
          "source": "Socket.IO reconnect and REST reconciliation"
        }
      ]
    },
    {
      "path": "server/src/socket/streaming.ts",
      "owner": "realtime",
      "productionStatus": "production-wired",
      "states": [
        {
          "name": "clients/eventBuffer",
          "classification": "intentionally-ephemeral",
          "source": "SSE reconnect; REST remains authoritative"
        }
      ]
    },
    {
      "path": "server/src/common/middleware/security.ts",
      "owner": "security",
      "productionStatus": "production-wired",
      "states": [
        {
          "name": "rate limiter counters",
          "classification": "intentionally-ephemeral",
          "source": "default process-local limiter; not cross-process security evidence"
        }
      ]
