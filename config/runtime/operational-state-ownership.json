    {
      "path": "server/src/distributed/DistributedExecutionCoordinator.ts",
      "owner": "distributed",
      "productionStatus": "compatibility-facade",
      "states": [
        {
          "name": "coordinator runtime",
          "classification": "restart-reconstructible",
          "source": "worker registration and queues"
        }
      ]
    },
    {
      "path": "server/src/distributed/execution/ExecutionJobQueue.ts",
      "owner": "distributed",
      "productionStatus": "production-wired",
      "states": [
        {
          "name": "queue/active",
          "classification": "intentionally-ephemeral",
          "source": "process execution handles"
        },
        {
          "name": "completed/deadLetter",
          "classification": "intentionally-ephemeral",
          "source": "current production-wired registry is restart-volatile; a durable follow-up is required before restart-safe job claims"
        }
      ]
    },
    {
      "path": "server/src/distributed/execution/ExecutionCoordinator.ts",
      "owner": "distributed",
      "productionStatus": "production-wired",
      "states": [
        {
          "name": "workers/health timer",
          "classification": "restart-reconstructible",
          "source": "worker registration and startup composition"
