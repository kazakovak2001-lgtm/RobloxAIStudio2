# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build output ─────────────────────────────────────────────────────────────
dist/
build/
out/

# ─── Persistent storage (assembly versions, not source code) ──────────────────
/storage/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
*.log.*
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Runtime / temp artifacts ─────────────────────────────────────────────────
tmp/
temp/
cache/
output/
*.tmp
*.temp

# ─── Error / debug dumps ──────────────────────────────────────────────────────
errors*.txt
debug*.txt
*.dump

# ─── Environment & secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── OS noise ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo
# Compiled JS/declaration output alongside source (tsc side-effects)
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
vite.config.js
vite.config.js.map
vite.config.d.ts
vite.config.d.ts.map

# ─── Vite ─────────────────────────────────────────────────────────────────────
.vite/

# ─── Generated reports (CI artifacts, not committed) ──────────────────────────
boundary-report.json
import-graph.json

# ─── Server TypeScript build output ─────────────────────────────────────────
server/dist/
server/**/*.js
server/**/*.js.map
server/**/*.d.ts
server/**/*.d.ts.map

# ─── Additional build directories ───────────────────────────────────────────
.next/
.nuxt/
.cache/
.parcel-cache/

# ─── Test coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ─── Additional IDEs ───────────────────────────────────────────────────────
.eclipse/
.settings/
*.sublime-project
*.sublime-workspace

# ─── Additional Windows artifacts ───────────────────────────────────────────
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk
