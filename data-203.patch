+  describe("Durable session activity", () => {
+    it("publishes session activity only after durable acknowledgement", async () => {
+      const now = vi.spyOn(Date, "now").mockReturnValue(1_000);
+      const storage = new InMemoryStorageProvider();
+      const auth = new AuthService(storage);
+      auth.register("activity@test.com", "password123", "activity-user");
+      const login = auth.login(
+        "activity@test.com",
+        "password123",
+        "activity-user",
+      );
+      const token = login.token!;
+      const before = storage.get<{ lastActivity: number }>(
+        "auth_sessions",
+        token,
+      )!;
+      let releaseMutation: (() => void) | undefined;
+      const originalSetDurable = storage.setDurable.bind(storage);
+      storage.setDurable = async (collection, id, data) => {
+        await new Promise<void>((resolve) => {
+          releaseMutation = resolve;
+        });
+        await originalSetDurable(collection, id, data);
+      };
+      now.mockReturnValue(2_000);
+
+      let settled = false;
+      const pending = auth.validateToken(token).finally(() => {
+        settled = true;
+      });
+      await Promise.resolve();
+
+      expect(settled).toBe(false);
+      expect(
+        storage.get<{ lastActivity: number }>("auth_sessions", token)
+          ?.lastActivity,
+      ).toBe(before.lastActivity);
+      if (!releaseMutation) {
+        throw new Error("Durable activity mutation was not blocked");
+      }
+
+      releaseMutation();
+      await expect(pending).resolves.toMatchObject({ lastActivity: 2_000 });
+      expect(
+        storage.get<{ lastActivity: number }>("auth_sessions", token)
+          ?.lastActivity,
+      ).toBe(2_000);
+      now.mockRestore();
+    });
+
+    it("preserves acknowledged activity when persistence rejects", async () => {
+      const now = vi.spyOn(Date, "now").mockReturnValue(1_000);
+      const storage = new InMemoryStorageProvider();
+      const auth = new AuthService(storage);
+      auth.register("reject@test.com", "password123", "reject-user");
+      const login = auth.login(
+        "reject@test.com",
+        "password123",
+        "reject-user",
+      );
+      const token = login.token!;
+      const before = storage.get<{ lastActivity: number }>(
+        "auth_sessions",
+        token,
+      )!;
+      storage.setDurable = async () => {
+        throw new Error("rejected activity write");
+      };
+      now.mockReturnValue(2_000);
+
+      await expect(auth.validateToken(token)).rejects.toThrow(
+        "rejected activity write",
+      );
+      expect(
+        storage.get<{ lastActivity: number }>("auth_sessions", token)
+          ?.lastActivity,
+      ).toBe(before.lastActivity);
+      now.mockRestore();
+    });
+  });
+
